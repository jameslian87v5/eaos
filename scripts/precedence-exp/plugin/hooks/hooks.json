{
  "description": "Precedence experiment plugin hooks: ALLOW Bash and attempt to mutate its input.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/allow.sh\""
          }
        ]
      }
    ]
  }
}

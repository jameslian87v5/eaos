# ──────────────────────────────────────────────────────────────────────────
# EAOS platform — environment reference. Copy to `.env` and fill in.
# `.env` is gitignored; never commit real secrets. Server auto-loads it via
# `import "dotenv/config"` (server/server.ts).
# ──────────────────────────────────────────────────────────────────────────

# === Security (REQUIRED for any non-local run) ===
# Strong random secret used to sign JWTs. Generate with: openssl rand -hex 32
# If left unset AND ALLOW_DEV_JWT_SECRET!=1, the server refuses to boot (fail-fast).
JWT_SECRET=
# OFF by default: a copied .env MUST fail fast rather than silently boot with
# the weak built-in secret. Set to 1 ONLY as an explicit local-dev opt-in;
# never enable in staging/production.
ALLOW_DEV_JWT_SECRET=
# JWT lifetime (e.g. 24h, 7d). Default 7d.
JWT_EXPIRES_IN=24h

# === Bootstrap admin (first start only) ===
# Created when the user table is empty. The seeded admin is forced to change
# its password on first login.
ADMIN_USERNAME=admin
# Leave unset to use the built-in default "admin123" (then forcibly rotated).
# Set a strong value instead for a real deploy.
ADMIN_PASSWORD=

# === Server ===
PORT=3001
# SQLite file path. Parent dir is created if missing.
DB_PATH=data/eaos.db
# Runtime: "local" (agents run in-process) or "docker" (agent-per-container).
# Docker mode needs the Docker daemon reachable (host socket); local is the
# default and needs no Docker.
RUNTIME_MODE=local

# === LLM provider (Zhipu/GLM via Anthropic-compatible endpoint) ===
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# Model alias passed to the SDK (defaults to "opus").
AGENT_MODEL=opus

# === Platform built-in web tools (W1) ===
# Bailian (DashScope) key for `bailian_search` (qwen-plus + forced web search).
# Read from process ENV by the platform-web-tools factory; NEVER placed in
# AGENT_SDK_OPTIONS (that blob is logged/inspectable). Forwarded to docker
# containers as container ENV by DockerAgentRuntime. When unset, only
# `web_fetch` is exposed (bailian_search is hidden). No real value here.
DASHSCOPE_API_KEY=

# === Optional feature flags ===
# Inline agent-driven UI cards. Off by default.
# A2UI v2: when on, the agent calls the `show_ui` MCP tool (schema-constrained,
# blocking). The call blocks until the user submits the rendered card (or the
# timeout fires), and the submitted values return as the tool_result IN THE
# SAME SDK turn. Both runtimes are wired: local (in-process SDK MCP server in
# ai-client) and docker (in-container server + a2ui_request/a2ui_response IPC).
# 无热重载 convention applies: flip this and stop/restart the runtime.
A2UI_ENABLED=false
# Per-card submit deadline (ms). Default 900000 (15 min). Clamped to [1s, 1h].
# The SDK's own MCP/stream-close timeout walls are raised to this + 30s buffer
# automatically when the a2ui server is active; you do not need to set
# CLAUDE_CODE_STREAM_CLOSE_TIMEOUT / MCP_TOOL_TIMEOUT yourself.
# A2UI_SUBMIT_TIMEOUT_MS=900000
# Widget token lifetime (default 30m).
WIDGET_TOKEN_EXPIRES_IN=30m

# === Docker agent runtime (only when RUNTIME_MODE=docker) ===
# Host port range mapped to each agent container's WS (9100).
# AGENT_WS_PORT_MIN / AGENT_WS_PORT_MAX may be used by container-manager if supported.

# === Skill Hub (iflytek) sync bridge ===
# When both are empty/unset, the sync bridge is safely disabled — no Hub calls,
# no shared-pool mutation, no entitlement mirror. Configure only when wiring a
# real Hub sync (R5b deployment / CLI / route). Token is used solely for the
# Authorization header; it is never persisted to the DB or audit log.
# SKILLHUB_URL=https://skillhub.example.com
# SKILLHUB_TOKEN=
# Optional CLI sync targets: "namespaceSlug=orgId,namespaceSlug2=orgId2"
# SKILLHUB_SYNC_TARGETS=
#
# R5d-1 background Skill sync worker. Periodic non-overlapping cycle that
# mirrors PUBLISHED Hub skills into the shared pool + org entitlement, so
# business users / org_admin never touch a token or run a sync command.
# SKILLHUB_TOKEN is the platform `skill:read` token, configured ONCE by
# deployment/ops via secret management — never committed, never in browser/DB/
# audit/logs. 0 = worker disabled (Hub unconfigured → safety no-op anyway).
# Default 300000 (5 min). Override for test environments only.
# SKILL_SYNC_INTERVAL_MS=300000

# === Skill Hub (iflytek) deployment baseline (R5b-1) ===
# Variables for deploying a local/test instance of the real iflytek/skillhub
# via compose.release.yml (prebuilt ghcr images — no host Java needed).
# These are deployment-shape variables; real secret values must NEVER enter Git,
# the browser, audit bodies, or logs. See docs/06-deployment/skillhub-runbook.md.
#
# Pin the upstream release version for a reproducible baseline:
#   latest = latest stable release (R5b-1 used this; NOTE: moving tag, NOT a
#           reproducible pin — capture the RepoDigest, and prefer vX.Y.Z for a
#           reproducible baseline once R5b-1 confirms the tag list)
#   edge   = latest main build (NOT reproducible — do not use for a baseline)
#   vX.Y.Z = fixed release tag (preferred for a reproducible baseline)
# SKILLHUB_VERSION=latest
#
# REQUIRED for a local/test baseline (compose.release.yml default is s3; with
# no S3 creds all built-in skills fail to publish: total=17 published=0 failed=17).
# local uses the skillhub_storage volume mount — no MinIO needed. Upstream
# .env.release.example confirms local is the zero-config runtime default.
# SKILLHUB_STORAGE_PROVIDER=local
#
# Required by compose.release.yml (no default). Generate with:
#   openssl rand -hex 32
# Store the real value in secret management, not in this file or Git.
# SKILLHUB_DOWNLOAD_ANON_COOKIE_SECRET=
#
# Bootstrap admin (zero-config quickstart; disable for real environments).
# Replace the password with a strong generated value (openssl rand -base64 24)
# stored in secret management — never commit a real password.
# BOOTSTRAP_ADMIN_ENABLED=false
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=<generate with: openssl rand -base64 24>
# BOOTSTRAP_ADMIN_EMAIL=admin@skillhub.local
# BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin
# BOOTSTRAP_ADMIN_USER_ID=docker-admin
#
# If the GHCR package is private, `docker login ghcr.io` before `docker compose up -d`.
# Pull fact (image visibility) is captured in docs/06-deployment/skillhub-contract-evidence.md.
{
  "name": "eaos",
  "version": "1.0.0",
  "type": "module",
  "description": "A simple chat application with Claude Agent SDK",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/server.ts",
    "dev:client": "vite --port 5173",
    "start": "tsx server/server.ts",
    "build": "vite build",
    "test:skill-config": "tsx server/skill-config.test.ts",
    "test:runtime-protocol": "tsx server/runtime-protocol.test.ts",
    "test:worker-protocol": "tsx server/local-agent-worker-protocol.test.ts",
    "test:microvm-probe": "node experiments/microsandbox-local-runtime/host-capability-probe.test.mjs",

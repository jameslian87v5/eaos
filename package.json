    "test:skillhub-bridge.prod": "tsx server/skillhub-bridge.prod.test.ts",
    "test:token-management": "DB_PATH=/tmp/token-management-test.db tsx server/token-management.test.ts",
    "test:model-management": "tsx server/model-management.test.ts",
    "test:model-catalog": "tsx server/model-catalog.test.ts",
    "test:model-selection": "tsx server/model-selection.test.ts",
    "test:token-usage-dashboard": "tsx server/token-usage-dashboard.test.ts",
    "test:context-compaction": "tsx server/context-compaction.test.ts",
    "test:provider-import": "tsx server/provider-import.test.ts",
    "test:model-definition-import": "tsx server/model-definition-import.test.ts",
